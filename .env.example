# Server environment label: LOCAL, PREPRODUCTION or PRODUCTION. Set explicitly on hosting.
APP_ENVIRONMENT=LOCAL

# Optional browser-facing canonical origin for deployments behind a trusted
# reverse proxy that rewrites the Host header. Exact origin only: scheme + host
# + optional port, with no path and no wildcard. Non-LOCAL environments require
# HTTPS. Same-host HTTPS -> internal HTTP TLS termination is handled automatically.
# GitHub Codespaces derives this value automatically in vite.config.ts; do not
# hard-code a Codespaces hostname here or in .dev.vars unless debugging.
APP_PUBLIC_ORIGIN=

# Copy to .dev.vars for local Cloudflare/Vite development; NEVER commit .dev.vars.
# Use client on the public site to disable operator views, simulation and internal payloads.
APP_EDITION=client

# Production data plane (server environment only).
# The project URL is public; the two keys and organization UUID are configured
# separately in each staging/production environment. Never expose SECRET_KEY
# to browser code and never commit a populated .dev.vars file.
SUPABASE_URL=https://exbhajwuniufgedbkipg.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Staging fixture organization only; use your own UUID for real production.
SUPABASE_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001

# AI provider policy -----------------------------------------------------------
# Active provider at startup. Admin can later select only providers explicitly
# listed in LLM_ENABLED_PROVIDERS and actually configured below.
LLM_PROVIDER=demo
LLM_ENABLED_PROVIDERS=gemini,groq,openai

# zero     = no hosted model calls
# free     = Gemini/Groq only; use provider accounts with paid billing disabled
# approved = explicitly configured paid/external providers also permitted
# This policy does not change the provider account's billing plan.
LLM_BUDGET_MODE=zero
# Optional server-owned provider deadline override (milliseconds, 1000-60000).
# Leave unset for normal defaults; P1.7 preproduction uses a bounded measured profile.
# LLM_REQUEST_TIMEOUT_MS=
# Optional natural-generation / factual-validation deadlines (1000-20000).
# LLM_GENERATION_TIMEOUT_MS=
# LLM_VALIDATION_TIMEOUT_MS=

# Optional legacy/runtime override for the currently active provider.
# Prefer the provider-specific *_MODEL variables below.
LLM_MODEL=

# Gemini ----------------------------------------------------------------------
# Gemini can run with LLM_BUDGET_MODE=free or approved.
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=

# Groq ------------------------------------------------------------------------
# Groq requires LLM_BUDGET_MODE=free or approved and its own server secret.
# Allowed models: openai/gpt-oss-120b, openai/gpt-oss-20b.
# These models run on Groq; their name does not use or enable the OpenAI API.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=

# Optional automatic failover. Prefer saving this policy from Admin > Performance.
# Disabled by default. Exactly one secondary per message, only network/5xx,
# inside the existing caller deadline. No failover on 429/auth/invalid output.
# Targets: gemini | groq | openai, with separate key/budget/allowlist checks.
# The secondary uses its provider-specific *_MODEL setting.
# P1 release, qualified generation/validation and health probes remain single-provider.
LLM_AUTO_FAILOVER=false
LLM_FALLBACK_PROVIDER=

# OpenAI ----------------------------------------------------------------------
# OpenAI requires LLM_BUDGET_MODE=approved.
# Put the exact API model identifier you have approved for this environment.
OPENAI_MODEL=
OPENAI_API_KEY=
# Optional: only set a reasoning effort supported by your exact API model.
# Empty omits the parameter; none is not supported by every model.
OPENAI_REASONING_EFFORT=

# Local Ollama ----------------------------------------------------------------
# Add "ollama" to LLM_ENABLED_PROVIDERS when you want it selectable.
# Use npm run ai:local -- --pull for the isolated local launcher.
OLLAMA_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://localhost:11434/v1

# Other OpenAI-compatible provider --------------------------------------------
# Add "compatible" to LLM_ENABLED_PROVIDERS and keep this HTTPS-only.
COMPATIBLE_MODEL=
COMPATIBLE_BASE_URL=
COMPATIBLE_API_KEY=

# Legacy aliases retained for backwards compatibility with compatible/Ollama
# deployments. New deployments should prefer the provider-specific variables.
LLM_BASE_URL=
LLM_API_KEY=

# Maximum LLM conversations per rolling 24 hours across the whole demo.
# Legacy chat may use up to 3 calls, plus at most 1 explicit failover attempt per
# message. Structured understanding uses 1 + at most 1. P1 has separate budgets.
# This is NOT a monetary billing cap; failed attempts may still have provider usage.
LLM_DAILY_LIMIT=100

# P1 staged rollout (apply D1 migration 0006 before enabling).
# legacy preserves the validated runtime; structured uses one understanding call
# and backend-owned planning/facts. Enable only after a live provider evaluation.
LLM_ORCHESTRATOR=legacy
# Optional provider capability: json_schema | json_object | prompt.
# Default: json_schema for OpenAI, Gemini and Groq; json_object for other providers.
# All modes undergo the same strict server validation.
LLM_STRUCTURED_OUTPUT=

# P1.3 opt-in: apply the hybrid retrieval migration and index published chunks first.
RAG_MODE=lexical
RAG_CORPUS_LOCALE=fr-FR
RAG_MARKET=GLOBAL
RAG_MIN_SIMILARITY=0.7
RAG_MIN_LEXICAL_SCORE=3
# Independent from the chat provider. 768-dimensional multilingual model required.
# openai | gemini | compatible | ollama; empty provider keeps embeddings disabled.
# Recommended Gemini production baseline: gemini-embedding-2 with the runtime's
# explicit 768-dimensional output contract.
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_REVISION=1
EMBEDDING_DAILY_LIMIT=100
# OpenAI always sends dimensions=768; optional for compatible/local endpoints.
EMBEDDING_SEND_DIMENSIONS=false

# P1.5/P1.7 natural generation: off | shadow | release.
# release produces an eligible candidate only; the server release gate remains authoritative.
LLM_GENERATION_MODE=off
# Separate atomic draft-call quota per organization/rolling 24h. Zero blocks all.
LLM_GENERATION_DAILY_LIMIT=0

# P1.6/P1.7 factual validation: off | shadow | release.
LLM_VALIDATION_MODE=off
LLM_VALIDATION_DAILY_LIMIT=0

# P1.7 customer rollout: off | shadow | canary | on.
# canary/on require structured orchestration, hybrid RAG and release-mode generation+validation.
P1_RELEASE_MODE=off
P1_CANARY_PERCENT=0
# Server-side stable cohort salt (minimum 16 characters in canary mode).
P1_CANARY_SALT=

# P1.7 signed release approval. Required for canary/on and generated only after
# automated live qualification + exact human review + no-spend finalization.
# The attestation is non-secret, but it is valid only with the server-only HMAC key.
P1_DEPLOYED_SOURCE_TREE_SHA=
P1_RELEASE_ATTESTATION=
P1_RELEASE_ATTESTATION_KEY=
