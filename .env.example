# Server environment label: LOCAL, PREPRODUCTION or PRODUCTION. Set explicitly on hosting.
APP_ENVIRONMENT=LOCAL
# Copy to .dev.vars for local Cloudflare/Vite development; NEVER commit .dev.vars.
# Use client on the public site to disable operator views, simulation and internal payloads.
APP_EDITION=client

# Production data plane (server environment only).
# The project URL is public; the two keys and organization UUID are configured
# separately in each staging/production environment. Never expose SECRET_KEY
# to browser code and never commit a populated .dev.vars file.
SUPABASE_URL=https://exbhajwuniufgedbkipg.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Staging fixture organization only; use your own UUID for real production.
SUPABASE_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001

# AI provider policy -----------------------------------------------------------
# Active provider at startup. Admin can later select only providers explicitly
# listed in LLM_ENABLED_PROVIDERS and actually configured below.
LLM_PROVIDER=demo
LLM_ENABLED_PROVIDERS=gemini,openai

# zero     = no hosted model calls
# free     = Gemini only
# approved = Gemini + explicitly configured paid/external providers
LLM_BUDGET_MODE=zero

# Optional legacy/runtime override for the currently active provider.
# Prefer the provider-specific *_MODEL variables below.
LLM_MODEL=

# Gemini ----------------------------------------------------------------------
# Gemini can run with LLM_BUDGET_MODE=free or approved.
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_API_KEY=

# OpenAI ----------------------------------------------------------------------
# OpenAI requires LLM_BUDGET_MODE=approved.
# Put the exact API model identifier you have approved for this environment.
OPENAI_MODEL=
OPENAI_API_KEY=
# Optional: only set a reasoning effort supported by your exact API model.
# Empty omits the parameter; none is not supported by every model.
OPENAI_REASONING_EFFORT=

# Local Ollama ----------------------------------------------------------------
# Add "ollama" to LLM_ENABLED_PROVIDERS when you want it selectable.
# Use npm run ai:local -- --pull for the isolated local launcher.
OLLAMA_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://localhost:11434/v1

# Other OpenAI-compatible provider --------------------------------------------
# Add "compatible" to LLM_ENABLED_PROVIDERS and keep this HTTPS-only.
COMPATIBLE_MODEL=
COMPATIBLE_BASE_URL=
COMPATIBLE_API_KEY=

# Legacy aliases retained for backwards compatibility with compatible/Ollama
# deployments. New deployments should prefer the provider-specific variables.
LLM_BASE_URL=
LLM_API_KEY=

# Maximum LLM conversations per rolling 24 hours across the whole demo.
# A conversation may use up to 3 model calls. This is NOT a monetary billing cap.
LLM_DAILY_LIMIT=100

# P1 staged rollout (apply D1 migration 0006 before enabling).
# legacy preserves the validated runtime; structured uses one understanding call
# and backend-owned planning/facts. Enable only after a live provider evaluation.
LLM_ORCHESTRATOR=legacy
# Optional provider capability: json_schema | json_object | prompt.
# Default: json_schema for OpenAI, json_object for other providers.
# All modes undergo the same strict server validation. No automatic paid retry.
LLM_STRUCTURED_OUTPUT=
