# Copy to .dev.vars for local Cloudflare/Vite development; NEVER commit .dev.vars.
LLM_PROVIDER=demo
# openai: set LLM_PROVIDER=openai, LLM_MODEL and OPENAI_API_KEY below.
# compatible: set LLM_PROVIDER=compatible and an OpenAI-compatible HTTP API.
LLM_MODEL=
OPENAI_API_KEY=
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
# Maximum LLM conversations per rolling 24 hours across the whole demo.
# A conversation may use up to 3 API calls. This is NOT a monetary billing cap.
LLM_DAILY_LIMIT=100
