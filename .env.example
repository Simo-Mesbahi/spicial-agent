# Copy to .dev.vars for local Cloudflare/Vite development; NEVER commit .dev.vars.
LLM_PROVIDER=demo
# Budget 0: external providers are blocked, even if an API key is present.
LLM_BUDGET_MODE=zero
# Use npm run ai:local -- --pull to configure a local-only Ollama session.
# Gemini is the only hosted provider permitted under LLM_BUDGET_MODE=free.
# Keep this secret only in the server environment, never in Git or browser code.
GEMINI_API_KEY=
# OpenAI/compatible remain available only after separate, explicit budget approval.
LLM_MODEL=
OPENAI_API_KEY=
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
# Maximum LLM conversations per rolling 24 hours across the whole demo.
# A conversation may use up to 3 model calls. This is NOT a monetary billing cap.
LLM_DAILY_LIMIT=100
